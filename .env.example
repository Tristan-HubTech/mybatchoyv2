APP_NAME=MyBatchoy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app
APP_TIMEZONE=Asia/Manila
FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (TiDB Cloud / MySQL 8 with TLS)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=4000
DB_DATABASE=mybatchoy
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Serverless-safe Cache & Sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_TABLE=sessions
SESSION_LIFETIME=20
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Persistent Media & Android APK Delivery (requires league/flysystem-aws-s3-v3 for s3 disk)
MEDIA_DISK=s3
APK_DISK=s3
MOBILE_APK_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production SMTP Email (never use MAIL_MAILER=log or array in production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Security & Token Controls
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
TRUSTED_PROXIES=
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
