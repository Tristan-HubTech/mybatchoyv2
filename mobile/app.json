{
  "expo": {
    "name": "MyBatchoy Inventory",
    "slug": "mybatchoy-inventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "primaryColor": "#E53935",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#111111",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mybatchoy.inventory"
    },
    "android": {
      "package": "com.mybatchoy.inventory",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "26559a92-3529-4b48-b884-9a0904879e13"
      }
    }
  }
}
